# Copy to .env (gitignored). Never commit real values.
# Filebase IPFS pinning (pin #1); bucket must be an IPFS bucket
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=
# Pinata (pin #2, independent of Filebase) — JWT from app.pinata.cloud > API Keys
PINATA_JWT=
# Austin open data app token (free, optional; raises Socrata rate limits)
SOCRATA_APP_TOKEN=
# Local internal reconciliation store (bootstrap-oracle-infra)
DATABASE_URL=postgresql://postgres:elephant@localhost:5432/elephant
DATA_DIR=
