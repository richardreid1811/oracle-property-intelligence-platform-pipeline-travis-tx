{
  // Single free-plan Worker: static UI assets + /api/chat relay to Workers AI.
  // No database: data is read by the browser from IPFS by CID. CHAT_CACHE (KV) only keeps model
  // replies to identical conversations so repeated questions don't spend the free AI allocation.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "travis-oracle",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "CHAT_CACHE", "id": "b18f4640f4cb40df9b4bf9032f513b17" }],
  "observability": { "enabled": true }
}
