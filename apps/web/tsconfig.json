{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "worker"]
}
